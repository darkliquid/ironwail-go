# Ignore everything by default
*

# Keep directory traversal so nested allow rules work
!*/

# Keep Go source files
!**/*.go

# Keep license/readme files
!/LICENSE.*
!/NOTICE
!/README.*
!/AGENTS.md

# Keep core module/task files at repo root
!/mise.toml
!/go.mod
!/go.sum
!/.golangci.yml
!/pkg/qgo/quake/go.mod
!/pkg/qgo/quakego/go.mod

# Keep this file
!.gitignore
!/docs/**/*.md
!/docs/**/*.txt
!/article/**/*.md
!/article/**/*.txt

# Parity tooling files
!/tasks/*.sh
tasks/perf_gate_reference.csv
!/testdata/
!/testdata/parity/
!/testdata/parity/*.json

# bv (beads viewer) local config and caches
.bv/

# Dolt database files (added by bd init)
.dolt/
*.db

.gemini/
gha-creds-*.json

# Beads / Dolt files (added by bd init)
.beads-credential-key

# Local scratch TMPDIR for Go toolchain
.tmp/
