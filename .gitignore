# Ignore everything by default
*

# Keep directory traversal so nested allow rules work
!*/

# Keep Go source files
!**/*.go

# Keep license/readme files
!/LICENSE.*
!/NOTICE
!/README.*
!/AGENTS.md

# Keep core module/task files at repo root
!/mise.toml
!/go.mod
!/go.sum
!/.golangci.yml
!/pkg/qgo/quake/go.mod
!/pkg/qgo/quakego/go.mod
!/cmd/qgo/testdata/**/go.mod

# Keep this file
!.gitignore
!/docs/**/*.md
!/docs/**/*.txt
!/article/**/*.md
!/article/**/*.txt

# Parity tooling files
!/tasks/*.sh
tasks/perf_gate_reference.csv
!/testdata/
!/testdata/parity/
!/testdata/parity/*.json
!/tools/parity_generator/c_patch/
!/tools/parity_generator/c_patch/*.patch

# Browser walkthrough static app (plan 22 Phase C)
!/web/
!/web/walkthrough/
!/web/walkthrough/*.html
!/web/walkthrough/*.js
!/web/walkthrough/*.css
!/web/walkthrough/*.json

# Deno wasm-walkthrough test suite + pollable harness wasm
!/web/deno-tests/
!/web/deno-tests/*.ts
!/web/deno-tests/*.md
!/web/deno-tests/deno.json
!/web/bin/
!/web/bin/ironwail-harness.wasm

# bv (beads viewer) local config and caches
.bv/

# Dolt database files (added by bd init)
.dolt/
*.db

.gemini/
gha-creds-*.json

# Beads / Dolt files (added by bd init)
.beads-credential-key

# Generated wasm progs embed (regenerated by mise run build-wasm)
/cmd/ironwailgo/progs_data.go

# Local scratch TMPDIR for Go toolchain
.tmp/

.gograph/

# Beads / Dolt files (added by bd init)
.beads/proxieddb/
